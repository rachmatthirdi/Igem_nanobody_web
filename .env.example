# Copy to .env and edit. Every value has a default except NB_DATA, which you
# should set deliberately.

# Where sessions and the shared model caches live. This directory is mounted at
# the SAME path inside the server container (the Docker daemon resolves bind-
# mount paths on the host), so use an absolute path with no spaces or colons.
NB_DATA=/srv/catchers

# Domain for automatic HTTPS, or :80 for plain HTTP.
SITE_ADDRESS=:80

# The tools image, pinned by digest. Pull it on the host first:
#   docker pull rachmatthirdi/igem_brawijaya@sha256:f5cc30e2a20816563ba558fb941b600f971e0f2035958d01305dee5060ac0843
NB_IMAGE=rachmatthirdi/igem_brawijaya@sha256:f5cc30e2a20816563ba558fb941b600f971e0f2035958d01305dee5060ac0843

# Per-user limits.
NB_MAX_BACKBONES=10
NB_MAX_SEQS=1
NB_BACKBONE_BUDGET=10

# Capacity and retention.
NB_MAX_QUEUE=5
NB_LIGHT_CONCURRENCY=3
NB_JOB_TIMEOUT_MIN=180
NB_SESSION_TTL_HOURS=72
NB_SESSION_DISK_MB=2000

# Shared results: what the service produced is visible to every visitor and is
# deleted this many days after it was produced.
NB_SHARED_RETENTION_DAYS=7
NB_SHARED_MAX_ENTRIES=2000
NB_SHARED_MAX_ENTRY_MB=100

# Abuse limits and timeouts.
NB_LIGHT_TIMEOUT_MIN=15
NB_NEW_SESSIONS_PER_IP_HOUR=20
NB_REQUESTS_PER_SECOND=4

# auto | on | off. "on" forces --gpus all even if the start-up probe failed.
NB_GPU_MODE=auto

# Extra flags for every tool container, e.g. "--cpus 8 --memory 24g --pids-limit 4096".
NB_DOCKER_RUN_ARGS=
